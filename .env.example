# Скопируй в .env: cp .env.example .env
# Значения ниже только для локальной разработки.

# Postgres
POSTGRES_DB=wrapt
POSTGRES_USER=wrapt
POSTGRES_PASSWORD=wrapt-local
# Порт на твоей машине. Поменяй, если 5432 занят другим Postgres.
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=wrapt
RABBITMQ_PASSWORD=wrapt-local

# S3-хранилище (RustFS)
S3_ACCESS_KEY=wrapt-local
S3_SECRET_KEY=wrapt-local-secret
