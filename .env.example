# Copy to .env: cp .env.example .env
# Values below are for local development only.

# Postgres
POSTGRES_DB=wrapt
POSTGRES_USER=wrapt
POSTGRES_PASSWORD=wrapt-local
# Port on your machine. Change it if 5432 is taken by another Postgres.
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=wrapt
RABBITMQ_PASSWORD=wrapt-local

# S3 storage (RustFS)
S3_ACCESS_KEY=wrapt-local
S3_SECRET_KEY=wrapt-local-secret

# App
# Local development value; in production NODE_ENV is set by the environment.
NODE_ENV=development
LOG_LEVEL=info
WORKER_PORT=3001